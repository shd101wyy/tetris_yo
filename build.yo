build :: import("std/build");

// raylib is a SYSTEM library (pkg-config). The Yo package `raylib_yo` is a
// DEPENDENCY, declared in yo.toml and imported by name from src/main.yo —
// it is no longer cloned into ./vendor by CI.
raylib :: build.system_library({
  name : "raylib",
  defines : "NOMINMAX NOGDI NOUSER"
});

exe :: build.executable({
  name : "tetris_yo",
  root : "./src/main.yo",
  optimize : build.Optimize.ReleaseFast
});
exe_wasm :: build.executable({
  name : "tetris_yo_wasm",
  root : "./src/main.yo",
  optimize : build.Optimize.ReleaseFast,
  target : build.CompilationTarget.Wasm32_Unknown_Emscripten
});

// Native links the system raylib; the WASM target picks raylib up from the
// Emscripten sysroot instead (see the workflow).
exe.link(raylib);

// Emscripten-specific flags: GLFW support and ASYNCIFY for the game loop
// `-lraylib` is explicit for the WASM target. Native gets raylib through
// `exe.link(raylib)` / pkg-config, but for wasm32-emscripten raylib is not a
// pkg-config package at all: the workflow builds it from source and copies
// `libraylib.a` into the Emscripten sysroot, which is already on emcc's -L
// path. Before the v0.2.32 migration this came transitively from
// `add_import_list(imports)`, which is gone; without it wasm-ld fails with
// `undefined symbol: DrawLine`.
exe_wasm.add_c_flags("-sUSE_GLFW=3 -sASYNCIFY -DPLATFORM_WEB -lraylib");

install_native :: build.step("install_native", "Build native executable");
install_native.depend_on(exe);

install_wasm :: build.step("install_wasm", "Build WASM executable");
install_wasm.depend_on(exe_wasm);

install :: build.step("install", "Build all targets");
install.depend_on(install_native);
install.depend_on(install_wasm);

run_step :: build.step("run", "Run the application");
run_step.depend_on(build.run(exe));
